              { className: 'bs-progress-meta' },
              h('span', null, tt('book.progress')),
              h('span', null, `${progress}%`),
            ),
            h(
              'div',
              {
                className: 'bs-track',
                role: 'progressbar',
                'aria-label': tt('book.progress'),
                'aria-valuemin': 0,
                'aria-valuemax': 100,
                'aria-valuenow': progress,
